{
  "name": "home-alone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api": "php -S 127.0.0.1:8080 -t public public/router.php",
    "setup": "php bin/console.php migrate && php bin/console.php seed",
    "test": "php tests/run.php",
    "test:api": "node --test tests/api.test.mjs",
    "test:demo": "node --test tests/demo.test.mjs",
    "test:cpanel": "node --test tests/cpanel.test.mjs",
    "prepare:cpanel": "composer install --no-dev --prefer-dist --optimize-autoloader && npm run build && node scripts/cpanel-manifest.mjs",
    "client:generate": "openapi-typescript public/openapi.json -o packages/client/src/schema.d.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
